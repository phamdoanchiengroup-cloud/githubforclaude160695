+  var doi = doc_('Doi').filter(function(d){ return String(d.LoaiDoi||'').toUpperCase() !== 'GH'; });
+  if (doi.length < 2) return sach_({ ok: false, msg: 'Cần ít nhất 2 đội (giải chung) để tạo lịch.' });
