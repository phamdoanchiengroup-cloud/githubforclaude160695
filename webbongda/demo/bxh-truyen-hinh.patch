+/* Xóa 1 trận */
+function xoaTran(token, maTran) {
+  var g = guard_(token); if (g) return g;
+  var t = doc_('TranDau').filter(function(x){ return x.MaTran === maTran; })[0];
+  if (!t) return sach_({ ok: false, msg: 'Không tìm thấy trận.' });
