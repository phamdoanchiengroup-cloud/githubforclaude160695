+      hoTen: c.HoTen, tenDoi: doiHienTai.TenDoi, logoUrl: doiHienTai.LogoUrl || '' });
+  }
+
+  // Pool đội chưa có ĐT
+  var doiTrong = doi.filter(function(d){ return !d.DoiTruongMaCT; });
