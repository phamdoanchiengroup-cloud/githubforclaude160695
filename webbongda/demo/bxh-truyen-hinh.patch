-/* Chuẩn hóa 1 tên: viết hoa chữ cái đầu mỗi từ */
-function chuanHoaTen_(ten) {
-  ten = String(ten || '').trim().replace(/\s+/g, ' ');
-  if (!ten) return '';
-  return ten.split(' ').map(function(t) {
-    t = String(t).toLowerCase();
-    if (!t) return '';
-    return t.charAt(0).toUpperCase() + t.slice(1);
-  }).join(' ');
-}
