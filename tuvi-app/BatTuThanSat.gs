/** Mùa theo chi tháng: Dần Mão Thìn xuân · Tỵ Ngọ Mùi hạ · Thân Dậu Tuất thu · Hợi Tý Sửu đông */
function thsMua_(chiThang) { return ['dong', 'dong', 'xuan', 'xuan', 'xuan', 'ha', 'ha', 'ha', 'thu', 'thu', 'thu', 'dong'][chiThang]; }
/**
 * An thần sát cho bốn trụ.
 * @param {Array} P  bốn trụ [{can, chi}] (chỉ số), thứ tự năm – tháng – ngày – giờ
 * @param {boolean} nam  giới tính nam
 * @return {Array} bốn danh sách [{t: tên, l: 'cat'|'hung'|'trung'}]
 */
function thsTheoTru_(P, nam) {
  var ra = [[], [], [], []], CC = P.map(function (p) { return CAN[p.can]; }), CH = P.map(function (p) { return CHI[p.chi]; });
  var TRU = P.map(function (p, i) { return CC[i] + ' ' + CH[i]; });
  function gan(i, e) { if (!ra[i].some(function (x) { return x.t === e.t; })) ra[i].push({ t: e.t, l: e.l, n: e.n }); }
  function trungDich(i, ds, dich) { return ds.indexOf(dich === 'can' ? CC[i] : CH[i]) >= 0 || (dich === 'canHoacChi' && ds.indexOf(CC[i]) >= 0); }
  function xetTru(a) { return a === 'ngay' ? [2] : a === 'ngayGio' ? [2, 3] : [0, 1, 2, 3]; }
  var duongNam = (P[0].can % 2 === 0) === !!nam;   // dương nam / âm nữ
  THS_DS.forEach(function (e) {
    var g = e.g, b = e.b, goc = [];
    if (e.a === 'tuDien') return;   // chỉ có trong từ điển (vd. Kình Dương = Dương Nhẫn)
    if (g === 'tru') { xetTru(e.a).forEach(function (i) { if (b.indexOf(TRU[i]) >= 0) gan(i, e); }); return; }
    if (g === 'mua+tru') { var ds = b[thsMua_(P[1].chi)] || []; xetTru(e.a).forEach(function (i) { if (ds.indexOf(TRU[i]) >= 0) gan(i, e); }); return; }
    if (g === 'canTuTru') {   // Tam Kỳ: ba can liền nhau đúng thứ tự
      Object.keys(b).forEach(function (k) { var s = b[k].join(); [0, 1].forEach(function (i0) { if ([CC[i0], CC[i0 + 1], CC[i0 + 2]].join() === s) [i0, i0 + 1, i0 + 2].forEach(function (i) { gan(i, e); }); }); });
      return;
    }
    if (g === 'tuanTruNgay') {   // Không Vong theo tuần trụ ngày
      var dau = CAN[0] + ' ' + CHI[(P[2].chi - P[2].can + 12) % 12], kv = b[dau] || [];
      [0, 1, 3].forEach(function (i) { if (kv.indexOf(CH[i]) >= 0) gan(i, e); });
      return;
    }
    if (g === 'chiTuTru') {   // Thiên La Địa Võng: đủ cặp chi
      Object.keys(b).forEach(function (k) { var c = b[k]; if (CH.indexOf(c[0]) >= 0 && CH.indexOf(c[1]) >= 0) [0, 1, 2, 3].forEach(function (i) { if (c.indexOf(CH[i]) >= 0) gan(i, e); }); });
      return;
    }
    if (g === 'chiNam') goc = [[CH[0], 0]];
    else if (g === 'chiThang') goc = [[CH[1], 1]];
    else if (g === 'chiNgay') goc = [[CH[2], 2]];
    else if (g === 'canNgay') goc = [[CC[2], 2]];
    else if (g === 'canNgayHoacNam') goc = [[CC[2], 2], [CC[0], 0]];
    else if (g === 'chiNamHoacNgay') goc = [[CH[0], 0], [CH[2], 2]];
    else if (g === 'chiNam+gioiTinh') { b = b[duongNam ? 'duongNam_amNu' : 'amNam_duongNu']; goc = [[CH[0], 0]]; }
    goc.forEach(function (o) {
      var dich = b[o[0]]; if (!dich) return;
      if (!Array.isArray(dich)) {   // Đức Tú: phải có cả Đức và Tú trong can tứ trụ
        var coDuc = CC.some(function (c) { return dich.duc.indexOf(c) >= 0; }), coTu = CC.some(function (c) { return dich.tu.indexOf(c) >= 0; });
        if (coDuc && coTu) [0, 1, 2, 3].forEach(function (i) { if (dich.duc.indexOf(CC[i]) >= 0 || dich.tu.indexOf(CC[i]) >= 0) gan(i, e); });
        return;
      }
      [0, 1, 2, 3].forEach(function (i) {
        if (e.a === 'conLai' && i === o[1]) return;
        if ((e.a === 'ngay' && i !== 2) || (e.a === 'ngayGio' && i < 2)) return;
        var ds = dich;
        if (e.a === 'vongGio' && i === 3) ds = b[CH[2]] || [];   // trụ giờ: cùng vòng, gốc là chi ngày
        if (trungDich(i, ds, e.d)) gan(i, e);
      });
    });
  });
  var THU = { tb: 0, tt: 1, hd: 2, tr: 3, nh: 4 };   // sao Tử Bình cốt lõi lên trước, sao chọn ngày xuống sau
  ra.forEach(function (ds) { ds.sort(function (x, y) { return THU[x.n] - THU[y.n]; }); });
  return ra;
}

/** Ý nghĩa các sao có trong lá số (gửi kèm kết quả để bấm nhãn xem nghĩa) */
function thsNghia_(T) {
  var can = {}, m = {};
  T.forEach(function (ds) { ds.forEach(function (x) { can[x.t] = 1; }); });
  THS_DS.forEach(function (e) { if (can[e.t]) m[e.t] = { l: e.l, n: e.n, y: e.y, de: e.de || '', k: e.k || '' }; });
  return m;
}

/** Từ điển thần sát cho tab Tham khảo – mở cho mọi người */
function thamKhaoThanSat() {
  return { ds: THS_DS.map(function (e) { return { t: e.t, l: e.l, n: e.n, an: e.an, y: e.y, k: e.k || '' }; }), nguon: THS_NGUON };
}
