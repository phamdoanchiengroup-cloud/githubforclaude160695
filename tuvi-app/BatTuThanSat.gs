  {"t":"Thiên Lại","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Dậu"],"Mão":["Ngọ"],"Thìn":["Mão"],"Tỵ":["Tý"],"Ngọ":["Dậu"],"Mùi":["Ngọ"],"Thân":["Mão"],"Dậu":["Tý"],"Tuất":["Dậu"],"Hợi":["Ngọ"],"Tý":["Mão"],"Sửu":["Tý"]},"an":"Theo tháng sinh (chi tháng): Dần, Ngọ, Tuất → Dậu; Mão, Mùi, Hợi → Ngọ; Thìn, Thân, Tý → Mão; Tỵ, Dậu, Sửu → Tý; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, sao này không thuận cho nhiều việc, nên thận trọng.","de":"Bạn có xu hướng gặp những lúc mọi việc không trôi chảy như ý.","k":"Khi thấy việc trục trặc liên tiếp, tạm lùi lại, rà soát nguyên nhân và điều chỉnh từng bước nhỏ."},
  {"t":"Thiên Hỏa","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tý"],"Mão":["Mão"],"Thìn":["Ngọ"],"Tỵ":["Dậu"],"Ngọ":["Tý"],"Mùi":["Mão"],"Thân":["Ngọ"],"Dậu":["Dậu"],"Tuất":["Tý"],"Hợi":["Mão"],"Tý":["Ngọ"],"Sửu":["Dậu"]},"an":"Theo tháng sinh (chi tháng): Dần, Ngọ, Tuất → Tý; Mão, Mùi, Hợi → Mão; Thìn, Thân, Tý → Ngọ; Tỵ, Dậu, Sửu → Dậu; xét cả bốn trụ.","y":"Thiên Hỏa là lửa trời, sao xấu trong lịch chọn ngày. Theo cổ thư, nên cẩn thận với lửa, điện và tránh nóng vội.","de":"Bạn có xu hướng nóng vội khi căng thẳng, dễ làm hỏng việc vì thiếu bình tĩnh.","k":"Kiểm tra an toàn điện, bếp trong nhà thường xuyên và tập hít thở sâu trước khi phản ứng lúc nóng giận."},
  {"t":"Tiểu Hồng Sa","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tỵ"],"Mão":["Dậu"],"Thìn":["Sửu"],"Tỵ":["Tỵ"],"Ngọ":["Dậu"],"Mùi":["Sửu"],"Thân":["Tỵ"],"Dậu":["Dậu"],"Tuất":["Sửu"],"Hợi":["Tỵ"],"Tý":["Dậu"],"Sửu":["Sửu"]},"an":"Theo tháng sinh (chi tháng): Dần, Tỵ, Thân, Hợi → Tỵ; Mão, Ngọ, Dậu, Tý → Dậu; Thìn, Mùi, Tuất, Sửu → Sửu; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, sao này không thuận cho nhiều việc, nên thận trọng.","de":"Bạn có xu hướng gặp những lúc mọi việc không trôi chảy như ý.","k":"Khi thấy việc trục trặc liên tiếp, tạm lùi lại, rà soát nguyên nhân và điều chỉnh từng bước nhỏ."},
  {"t":"Đại Hao (Ngọc Hạp)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Ngọ"],"Mão":["Mùi"],"Thìn":["Thân"],"Tỵ":["Dậu"],"Ngọ":["Tuất"],"Mùi":["Hợi"],"Thân":["Tý"],"Dậu":["Sửu"],"Tuất":["Dần"],"Hợi":["Mão"],"Tý":["Thìn"],"Sửu":["Tỵ"]},"an":"Theo tháng sinh (chi tháng): Dần → Ngọ; Mão → Mùi; Thìn → Thân; Tỵ → Dậu; Ngọ → Tuất; Mùi → Hợi; Thân → Tý; Dậu → Sửu; Tuất → Dần; Hợi → Mão; Tý → Thìn; Sửu → Tỵ; xét cả bốn trụ.","y":"Đại Hao là hao tốn lớn, sao xấu trong sách chọn ngày Ngọc Hạp. Theo cổ thư, nên cẩn trọng chi tiêu.","de":"Bạn có xu hướng chi tiêu theo cảm hứng và khó giữ tiền lâu trong tay.","k":"Lập ngân sách hằng tháng, tự động trích tiết kiệm trước khi chi tiêu và cân nhắc kỹ các khoản lớn."},
  {"t":"Nguyệt Phá","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Thân"],"Mão":["Dậu"],"Thìn":["Tuất"],"Tỵ":["Hợi"],"Ngọ":["Tý"],"Mùi":["Sửu"],"Thân":["Dần"],"Dậu":["Mão"],"Tuất":["Thìn"],"Hợi":["Tỵ"],"Tý":["Ngọ"],"Sửu":["Mùi"]},"an":"Theo tháng sinh (chi tháng): Dần → Thân; Mão → Dậu; Thìn → Tuất; Tỵ → Hợi; Ngọ → Tý; Mùi → Sửu; Thân → Dần; Dậu → Mão; Tuất → Thìn; Hợi → Tỵ; Tý → Ngọ; Sửu → Mùi; xét cả bốn trụ.","y":"Nguyệt Phá là sao xung với tháng. Theo cổ thư, sao này dễ gây đổ vỡ, hao tán.","de":"Bạn có xu hướng muốn phá bỏ cái cũ để làm mới, đôi khi tạo va chạm với người xung quanh.","k":"Trước khi thay đổi lớn, hãy trao đổi với người liên quan và giữ lại phần nền tảng đang tốt."},
  {"t":"Địa Phá","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Hợi"],"Mão":["Tý"],"Thìn":["Sửu"],"Tỵ":["Dần"],"Ngọ":["Mão"],"Mùi":["Thìn"],"Thân":["Tỵ"],"Dậu":["Ngọ"],"Tuất":["Mùi"],"Hợi":["Thân"],"Tý":["Dậu"],"Sửu":["Tuất"]},"an":"Theo tháng sinh (chi tháng): Dần → Hợi; Mão → Tý; Thìn → Sửu; Tỵ → Dần; Ngọ → Mão; Mùi → Thìn; Thân → Tỵ; Dậu → Ngọ; Tuất → Mùi; Hợi → Thân; Tý → Dậu; Sửu → Tuất; xét cả bốn trụ.","y":"Địa Phá là sao xấu về đất đai. Theo cổ thư, không nên xây dựng, sửa nhà vào ngày có sao này.","de":"Bạn có xu hướng gặp nhiều lo toan trong chuyện nhà cửa, đất đai.","k":"Với việc nhà đất, kiểm tra pháp lý kỹ, thuê người có chuyên môn và dự trù chi phí phát sinh."},
  {"t":"Thổ Phủ","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Dần"],"Mão":["Mão"],"Thìn":["Thìn"],"Tỵ":["Tỵ"],"Ngọ":["Ngọ"],"Mùi":["Mùi"],"Thân":["Thân"],"Dậu":["Dậu"],"Tuất":["Tuất"],"Hợi":["Hợi"],"Tý":["Tý"],"Sửu":["Sửu"]},"an":"Theo tháng sinh (chi tháng): Dần → Dần; Mão → Mão; Thìn → Thìn; Tỵ → Tỵ; Ngọ → Ngọ; Mùi → Mùi; Thân → Thân; Dậu → Dậu; Tuất → Tuất; Hợi → Hợi; Tý → Tý; Sửu → Sửu; xét cả bốn trụ.","y":"Thổ Phủ là sao xấu về đất. Theo cổ thư, không nên động thổ vào ngày có sao này.","de":"Bạn có xu hướng gặp nhiều lo toan trong chuyện nhà cửa, đất đai.","k":"Với việc nhà đất, kiểm tra pháp lý kỹ, thuê người có chuyên môn và dự trù chi phí phát sinh."},
  {"t":"Thổ Ôn (Thiên Cẩu)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Thìn"],"Mão":["Tỵ"],"Thìn":["Ngọ"],"Tỵ":["Mùi"],"Ngọ":["Thân"],"Mùi":["Dậu"],"Thân":["Tuất"],"Dậu":["Hợi"],"Tuất":["Tý"],"Hợi":["Sửu"],"Tý":["Dần"],"Sửu":["Mão"]},"an":"Theo tháng sinh (chi tháng): Dần → Thìn; Mão → Tỵ; Thìn → Ngọ; Tỵ → Mùi; Ngọ → Thân; Mùi → Dậu; Thân → Tuất; Dậu → Hợi; Tuất → Tý; Hợi → Sửu; Tý → Dần; Sửu → Mão; xét cả bốn trụ.","y":"Thổ Ôn là sao xấu về đất. Theo cổ thư, không nên đào đất, xây dựng vào ngày có sao này.","de":"Bạn có xu hướng gặp nhiều lo toan trong chuyện nhà cửa, đất đai.","k":"Với việc nhà đất, kiểm tra pháp lý kỹ, thuê người có chuyên môn và dự trù chi phí phát sinh."},
  {"t":"Thọ Tử (Thụ Tử)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tuất"],"Mão":["Thìn"],"Thìn":["Hợi"],"Tỵ":["Tỵ"],"Ngọ":["Tý"],"Mùi":["Ngọ"],"Thân":["Sửu"],"Dậu":["Mùi"],"Tuất":["Dần"],"Hợi":["Thân"],"Tý":["Mão"],"Sửu":["Dậu"]},"an":"Theo tháng sinh (chi tháng): Dần → Tuất; Mão → Thìn; Thìn → Hợi; Tỵ → Tỵ; Ngọ → Tý; Mùi → Ngọ; Thân → Sửu; Dậu → Mùi; Tuất → Dần; Hợi → Thân; Tý → Mão; Sửu → Dậu; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, không nên làm việc lớn vào ngày có sao này và nên chú ý giữ sức.","de":"Bạn có xu hướng ôm đồm việc lớn khi sức lực chưa sẵn sàng.","k":"Chỉ nhận việc lớn khi đã nghỉ ngơi đủ, lượng sức mình và chia bớt phần việc cho người khác."},
  {"t":"Hoang Vu","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tỵ","Dậu","Sửu"],"Mão":["Tỵ","Dậu","Sửu"],"Thìn":["Tỵ","Dậu","Sửu"],"Tỵ":["Thân","Tý","Thìn"],"Ngọ":["Thân","Tý","Thìn"],"Mùi":["Thân","Tý","Thìn"],"Thân":["Hợi","Mão","Mùi"],"Dậu":["Hợi","Mão","Mùi"],"Tuất":["Hợi","Mão","Mùi"],"Hợi":["Dần","Ngọ","Tuất"],"Tý":["Dần","Ngọ","Tuất"],"Sửu":["Dần","Ngọ","Tuất"]},"an":"Theo tháng sinh (chi tháng): Dần, Mão, Thìn → Tỵ, Dậu, Sửu; Tỵ, Ngọ, Mùi → Thân, Tý, Thìn; Thân, Dậu, Tuất → Hợi, Mão, Mùi; Hợi, Tý, Sửu → Dần, Ngọ, Tuất; xét cả bốn trụ.","y":"Hoang Vu là trống trải. Theo cổ thư, việc làm vào ngày có sao này khó có kết quả.","de":"Bạn có xu hướng bỏ nhiều công sức nhưng chưa thấy kết quả tương xứng.","k":"Đặt mục tiêu đo lường được, kiểm tra tiến độ định kỳ và mạnh dạn bỏ những việc không hiệu quả."},
  {"t":"Thiên Tặc","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Thìn"],"Mão":["Dậu"],"Thìn":["Dần"],"Tỵ":["Mùi"],"Ngọ":["Tý"],"Mùi":["Tỵ"],"Thân":["Tuất"],"Dậu":["Mão"],"Tuất":["Thân"],"Hợi":["Sửu"],"Tý":["Ngọ"],"Sửu":["Hợi"]},"an":"Theo tháng sinh (chi tháng): Dần → Thìn; Mão → Dậu; Thìn → Dần; Tỵ → Mùi; Ngọ → Tý; Mùi → Tỵ; Thân → Tuất; Dậu → Mão; Tuất → Thân; Hợi → Sửu; Tý → Ngọ; Sửu → Hợi; xét cả bốn trụ.","y":"Thiên Tặc là kẻ trộm trời, sao xấu trong lịch chọn ngày. Theo cổ thư, nên đề phòng mất mát của cải.","de":"Bạn có xu hướng dễ tin người và đôi khi lơ là với việc giữ gìn tài sản.","k":"Khóa cửa, bảo mật tài khoản kỹ, không cho mượn tiền khi chưa rõ ràng và cảnh giác với lời mời quá hấp dẫn."},
  {"t":"Địa Tặc","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Sửu"],"Mão":["Tý"],"Thìn":["Hợi"],"Tỵ":["Tuất"],"Ngọ":["Dậu"],"Mùi":["Thân"],"Thân":["Mùi"],"Dậu":["Ngọ"],"Tuất":["Tỵ"],"Hợi":["Thìn"],"Tý":["Mão"],"Sửu":["Dần"]},"an":"Theo tháng sinh (chi tháng): Dần → Sửu; Mão → Tý; Thìn → Hợi; Tỵ → Tuất; Ngọ → Dậu; Mùi → Thân; Thân → Mùi; Dậu → Ngọ; Tuất → Tỵ; Hợi → Thìn; Tý → Mão; Sửu → Dần; xét cả bốn trụ.","y":"Địa Tặc là kẻ trộm đất, sao xấu trong lịch chọn ngày. Theo cổ thư, nên đề phòng mất mát và người xấu.","de":"Bạn có xu hướng dễ tin người và đôi khi lơ là với việc giữ gìn tài sản.","k":"Khóa cửa, bảo mật tài khoản kỹ, không cho mượn tiền khi chưa rõ ràng và cảnh giác với lời mời quá hấp dẫn."},
  {"t":"Hỏa Tai","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Sửu"],"Mão":["Mùi"],"Thìn":["Dần"],"Tỵ":["Thân"],"Ngọ":["Mão"],"Mùi":["Dậu"],"Thân":["Thìn"],"Dậu":["Tuất"],"Tuất":["Tỵ"],"Hợi":["Hợi"],"Tý":["Ngọ"],"Sửu":["Tý"]},"an":"Theo tháng sinh (chi tháng): Dần → Sửu; Mão → Mùi; Thìn → Dần; Tỵ → Thân; Ngọ → Mão; Mùi → Dậu; Thân → Thìn; Dậu → Tuất; Tuất → Tỵ; Hợi → Hợi; Tý → Ngọ; Sửu → Tý; xét cả bốn trụ.","y":"Hỏa Tai là tai họa về lửa. Theo cổ thư, nên cẩn thận với lửa và tránh nóng nảy làm hỏng việc.","de":"Bạn có xu hướng nóng vội khi căng thẳng, dễ làm hỏng việc vì thiếu bình tĩnh.","k":"Kiểm tra an toàn điện, bếp trong nhà thường xuyên và tập hít thở sâu trước khi phản ứng lúc nóng giận."},
  {"t":"Nguyệt Yếm (Đại Họa)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tuất"],"Mão":["Dậu"],"Thìn":["Thân"],"Tỵ":["Mùi"],"Ngọ":["Ngọ"],"Mùi":["Tỵ"],"Thân":["Thìn"],"Dậu":["Mão"],"Tuất":["Dần"],"Hợi":["Sửu"],"Tý":["Tý"],"Sửu":["Hợi"]},"an":"Theo tháng sinh (chi tháng): Dần → Tuất; Mão → Dậu; Thìn → Thân; Tỵ → Mùi; Ngọ → Ngọ; Mùi → Tỵ; Thân → Thìn; Dậu → Mão; Tuất → Dần; Hợi → Sửu; Tý → Tý; Sửu → Hợi; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, sao này dễ kéo theo thị phi, không nên xuất hành hay cưới hỏi vào ngày có sao này.","de":"Bạn có xu hướng dễ bị hiểu lầm hoặc trở thành đề tài bàn tán.","k":"Nói rõ ràng, giữ lời hứa và tránh tham gia bàn tán sau lưng người khác."},
  {"t":"Địa Hỏa","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tuất"],"Mão":["Dậu"],"Thìn":["Thân"],"Tỵ":["Mùi"],"Ngọ":["Ngọ"],"Mùi":["Tỵ"],"Thân":["Thìn"],"Dậu":["Mão"],"Tuất":["Dần"],"Hợi":["Sửu"],"Tý":["Tý"],"Sửu":["Hợi"]},"an":"Theo tháng sinh (chi tháng): Dần → Tuất; Mão → Dậu; Thìn → Thân; Tỵ → Mùi; Ngọ → Ngọ; Mùi → Tỵ; Thân → Thìn; Dậu → Mão; Tuất → Dần; Hợi → Sửu; Tý → Tý; Sửu → Hợi; xét cả bốn trụ.","y":"Địa Hỏa là lửa đất, sao xấu trong lịch chọn ngày. Theo cổ thư, nên cẩn thận với lửa và tránh nóng vội.","de":"Bạn có xu hướng nóng vội khi căng thẳng, dễ làm hỏng việc vì thiếu bình tĩnh.","k":"Kiểm tra an toàn điện, bếp trong nhà thường xuyên và tập hít thở sâu trước khi phản ứng lúc nóng giận."},
  {"t":"Nguyệt Hư (Nguyệt Sát)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Sửu"],"Mão":["Tuất"],"Thìn":["Mùi"],"Tỵ":["Thìn"],"Ngọ":["Sửu"],"Mùi":["Tuất"],"Thân":["Mùi"],"Dậu":["Thìn"],"Tuất":["Sửu"],"Hợi":["Tuất"],"Tý":["Mùi"],"Sửu":["Thìn"]},"an":"Theo tháng sinh (chi tháng): Dần, Ngọ, Tuất → Sửu; Mão, Mùi, Hợi → Tuất; Thìn, Thân, Tý → Mùi; Tỵ, Dậu, Sửu → Thìn; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, sao này gây trở ngại, không nên cưới hỏi, khai trương vào ngày có sao này.","de":"Bạn có xu hướng gặp trục trặc ở những bước khởi đầu quan trọng.","k":"Chuẩn bị kỹ lưỡng trước các sự kiện quan trọng, có danh sách kiểm tra và thời gian dự phòng."},
  {"t":"Hoàng Sa","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Ngọ"],"Mão":["Dần"],"Thìn":["Tý"],"Tỵ":["Ngọ"],"Ngọ":["Dần"],"Mùi":["Tý"],"Thân":["Ngọ"],"Dậu":["Dần"],"Tuất":["Tý"],"Hợi":["Ngọ"],"Tý":["Dần"],"Sửu":["Tý"]},"an":"Theo tháng sinh (chi tháng): Dần, Tỵ, Thân, Hợi → Ngọ; Mão, Ngọ, Dậu, Tý → Dần; Thìn, Mùi, Tuất, Sửu → Tý; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, không nên xuất hành xa vào ngày có sao này.","de":"Bạn có xu hướng gặp trục trặc khi đi xa nếu chuẩn bị vội vàng.","k":"Lên lịch trình sớm, kiểm tra giấy tờ, phương tiện và để dư thời gian cho mỗi chuyến đi."},
  {"t":"Phi Ma Sát (Ngọc Hạp)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tý"],"Mão":["Dậu"],"Thìn":["Ngọ"],"Tỵ":["Mão"],"Ngọ":["Tý"],"Mùi":["Dậu"],"Thân":["Ngọ"],"Dậu":["Mão"],"Tuất":["Tý"],"Hợi":["Dậu"],"Tý":["Ngọ"],"Sửu":["Mão"]},"an":"Theo tháng sinh (chi tháng): Dần, Ngọ, Tuất → Tý; Mão, Mùi, Hợi → Dậu; Thìn, Thân, Tý → Ngọ; Tỵ, Dậu, Sửu → Mão; xét cả bốn trụ.","y":"Sao xấu trong sách chọn ngày Ngọc Hạp. Theo cổ thư, sao này chủ lo âu, buồn phiền.","de":"Bạn có xu hướng nhạy cảm với nỗi buồn và để những lo lắng gia đình đè nặng trong lòng.","k":"Duy trì việc thăm hỏi, quan tâm người thân thường xuyên và tìm cách giải tỏa cảm xúc lành mạnh như vận động, trò chuyện."},
  {"t":"Ngũ Quỷ (Ngọc Hạp)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Ngọ"],"Mão":["Dần"],"Thìn":["Thìn"],"Tỵ":["Dậu"],"Ngọ":["Mão"],"Mùi":["Thân"],"Thân":["Sửu"],"Dậu":["Tỵ"],"Tuất":["Tý"],"Hợi":["Hợi"],"Tý":["Mùi"],"Sửu":["Tuất"]},"an":"Theo tháng sinh (chi tháng): Dần → Ngọ; Mão → Dần; Thìn → Thìn; Tỵ → Dậu; Ngọ → Mão; Mùi → Thân; Thân → Sửu; Dậu → Tỵ; Tuất → Tý; Hợi → Hợi; Tý → Mùi; Sửu → Tuất; xét cả bốn trụ.","y":"Sao xấu trong sách chọn ngày Ngọc Hạp. Theo cổ thư, sao này chủ người xấu quấy phá, tinh thần bất an.","de":"Bạn có xu hướng dễ bất an khi môi trường xung quanh có người không thiện chí.","k":"Chọn lọc người để tin tưởng, giữ thông tin cá nhân kín đáo và duy trì thói quen giúp tâm trí ổn định như ngủ đủ, thiền, đi bộ."},
  {"t":"Hà Khôi (Cẩu Giảo)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Hợi"],"Mão":["Ngọ"],"Thìn":["Sửu"],"Tỵ":["Thân"],"Ngọ":["Mão"],"Mùi":["Tuất"],"Thân":["Tỵ"],"Dậu":["Tý"],"Tuất":["Mùi"],"Hợi":["Dần"],"Tý":["Dậu"],"Sửu":["Thìn"]},"an":"Theo tháng sinh (chi tháng): Dần → Hợi; Mão → Ngọ; Thìn → Sửu; Tỵ → Thân; Ngọ → Mão; Mùi → Tuất; Thân → Tỵ; Dậu → Tý; Tuất → Mùi; Hợi → Dần; Tý → Dậu; Sửu → Thìn; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, không nên khởi công vào ngày có sao này, dễ bị đố kỵ.","de":"Bạn có xu hướng dễ khiến người khác ganh tị khi bạn nổi bật.","k":"Khiêm tốn khi thành công, chia sẻ công lao với đồng đội và tránh khoe khoang."},
  {"t":"Vãng Vong (Thổ Kỵ)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Dần"],"Mão":["Tỵ"],"Thìn":["Thân"],"Tỵ":["Hợi"],"Ngọ":["Mão"],"Mùi":["Ngọ"],"Thân":["Dậu"],"Dậu":["Tý"],"Tuất":["Thìn"],"Hợi":["Mùi"],"Tý":["Tuất"],"Sửu":["Sửu"]},"an":"Theo tháng sinh (chi tháng): Dần → Dần; Mão → Tỵ; Thìn → Thân; Tỵ → Hợi; Ngọ → Mão; Mùi → Ngọ; Thân → Dậu; Dậu → Tý; Tuất → Thìn; Hợi → Mùi; Tý → Tuất; Sửu → Sửu; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, đi xa dễ trắc trở, không nên khởi sự lớn vào ngày có sao này.","de":"Bạn có xu hướng gặp trục trặc khi đi xa nếu chuẩn bị vội vàng.","k":"Lên lịch trình sớm, kiểm tra giấy tờ, phương tiện và để dư thời gian cho mỗi chuyến đi."},
  {"t":"Cửu Không","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Thìn"],"Mão":["Sửu"],"Thìn":["Tuất"],"Tỵ":["Mùi"],"Ngọ":["Mão"],"Mùi":["Tý"],"Thân":["Dậu"],"Dậu":["Ngọ"],"Tuất":["Dần"],"Hợi":["Hợi"],"Tý":["Thân"],"Sửu":["Tỵ"]},"an":"Theo tháng sinh (chi tháng): Dần → Thìn; Mão → Sửu; Thìn → Tuất; Tỵ → Mùi; Ngọ → Mão; Mùi → Tý; Thân → Dậu; Dậu → Ngọ; Tuất → Dần; Hợi → Hợi; Tý → Thân; Sửu → Tỵ; xét cả bốn trụ.","y":"Cửu Không là trống rỗng. Theo cổ thư, không nên cầu tài vào ngày có sao này.","de":"Bạn có xu hướng kỳ vọng thu về nhanh nhưng kết quả tài chính đến chậm hơn mong đợi.","k":"Đầu tư từ từ, chỉ dùng tiền nhàn rỗi và đánh giá kỹ khả năng sinh lời trước khi bỏ vốn."},
  {"t":"Trùng Tang","l":"hung","n":"nh","g":"chiThang","d":"can","a":"tatCa","b":{"Dần":["Giáp"],"Mão":["Ất"],"Thìn":["Kỷ"],"Tỵ":["Bính"],"Ngọ":["Đinh"],"Mùi":["Kỷ"],"Thân":["Canh"],"Dậu":["Tân"],"Tuất":["Kỷ"],"Hợi":["Nhâm"],"Tý":["Quý"],"Sửu":["Kỷ"]},"an":"Theo tháng sinh (chi tháng): Dần → Giáp; Mão → Ất; Thìn, Mùi, Tuất, Sửu → Kỷ; Tỵ → Bính; Ngọ → Đinh; Thân → Canh; Dậu → Tân; Hợi → Nhâm; Tý → Quý; xét cả bốn trụ.","y":"Một sao xấu trong lịch chọn ngày. Theo cổ thư, không nên cưới hỏi hay làm lễ lớn của gia đình vào ngày có sao này.","de":"Bạn có xu hướng gặp nhiều lo toan dồn dập trong những việc hệ trọng của gia đình.","k":"Chia sẻ việc lớn trong nhà cho các thành viên, lên kế hoạch sớm và giữ không khí đoàn kết."},
  {"t":"Lôi Công","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Dần"],"Mão":["Hợi"],"Thìn":["Tỵ"],"Tỵ":["Thân"],"Ngọ":["Dần"],"Mùi":["Hợi"],"Thân":["Tỵ"],"Dậu":["Thân"],"Tuất":["Dần"],"Hợi":["Hợi"],"Tý":["Tỵ"],"Sửu":["Thân"]},"an":"Theo tháng sinh (chi tháng): Dần, Ngọ, Tuất → Dần; Mão, Mùi, Hợi → Hợi; Thìn, Thân, Tý → Tỵ; Tỵ, Dậu, Sửu → Thân; xét cả bốn trụ.","y":"Lôi Công là thần sấm, sao xấu trong lịch chọn ngày. Theo cổ thư, không nên xây dựng vào ngày có sao này.","de":"Bạn có xu hướng gặp nhiều lo toan trong chuyện nhà cửa, đất đai.","k":"Với việc nhà đất, kiểm tra pháp lý kỹ, thuê người có chuyên môn và dự trù chi phí phát sinh."},
  {"t":"Quả Tú (Ngọc Hạp)","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Thìn"],"Mão":["Tỵ"],"Thìn":["Ngọ"],"Tỵ":["Mùi"],"Ngọ":["Thân"],"Mùi":["Dậu"],"Thân":["Tuất"],"Dậu":["Hợi"],"Tuất":["Tý"],"Hợi":["Sửu"],"Tý":["Dần"],"Sửu":["Mão"]},"an":"Theo tháng sinh (chi tháng): Dần → Thìn; Mão → Tỵ; Thìn → Ngọ; Tỵ → Mùi; Ngọ → Thân; Mùi → Dậu; Thân → Tuất; Dậu → Hợi; Tuất → Tý; Hợi → Sửu; Tý → Dần; Sửu → Mão; xét cả bốn trụ.","y":"Sao xấu trong sách chọn ngày Ngọc Hạp. Theo cổ thư, không nên cưới hỏi vào ngày có sao này.","de":"Bạn có xu hướng cần nhiều thời gian và sự chủ động để vun đắp chuyện hôn nhân.","k":"Dành thời gian cố định để trò chuyện thật lòng với người bạn đời và cùng làm những hoạt động chung."},
  {"t":"Nguyệt Hình","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tỵ"],"Mão":["Tý"],"Thìn":["Thìn"],"Tỵ":["Thân"],"Ngọ":["Ngọ"],"Mùi":["Sửu"],"Thân":["Dần"],"Dậu":["Dậu"],"Tuất":["Mùi"],"Hợi":["Hợi"],"Tý":["Mão"],"Sửu":["Tuất"]},"an":"Theo tháng sinh (chi tháng): Dần → Tỵ; Mão → Tý; Thìn → Thìn; Tỵ → Thân; Ngọ → Ngọ; Mùi → Sửu; Thân → Dần; Dậu → Dậu; Tuất → Mùi; Hợi → Hợi; Tý → Mão; Sửu → Tuất; xét cả bốn trụ.","y":"Nguyệt Hình là hình phạt của tháng. Theo cổ thư, sao này dễ kéo theo rắc rối, va chạm.","de":"Bạn có xu hướng thẳng thắn bày tỏ quan điểm, đôi khi vướng vào tranh luận hoặc thủ tục rườm rà.","k":"Giữ giấy tờ đầy đủ, đọc kỹ trước khi ký và ưu tiên hòa giải trước khi để bất đồng đi xa."},
  {"t":"Ngũ Hư","l":"hung","n":"nh","g":"chiThang","d":"chi","a":"tatCa","b":{"Dần":["Tỵ","Dậu","Sửu"],"Mão":["Tỵ","Dậu","Sửu"],"Thìn":["Tỵ","Dậu","Sửu"],"Tỵ":["Thân","Tý","Thìn"],"Ngọ":["Thân","Tý","Thìn"],"Mùi":["Thân","Tý","Thìn"],"Thân":["Hợi","Mão","Mùi"],"Dậu":["Hợi","Mão","Mùi"],"Tuất":["Hợi","Mão","Mùi"],"Hợi":["Dần","Ngọ","Tuất"],"Tý":["Dần","Ngọ","Tuất"],"Sửu":["Dần","Ngọ","Tuất"]},"an":"Theo tháng sinh (chi tháng): Dần, Mão, Thìn → Tỵ, Dậu, Sửu; Tỵ, Ngọ, Mùi → Thân, Tý, Thìn; Thân, Dậu, Tuất → Hợi, Mão, Mùi; Hợi, Tý, Sửu → Dần, Ngọ, Tuất; xét cả bốn trụ.","y":"Ngũ Hư là năm điều trống rỗng. Theo cổ thư, không nên khởi tạo hay cưới hỏi vào ngày có sao này.","de":"Bạn có xu hướng gặp trục trặc ở những bước khởi đầu quan trọng.","k":"Chuẩn bị kỹ lưỡng trước các sự kiện quan trọng, có danh sách kiểm tra và thời gian dự phòng."},
