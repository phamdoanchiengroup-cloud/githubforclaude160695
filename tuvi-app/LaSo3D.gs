"\"  /* ---------------- Cảnh 3D: Bốn trụ trời ----------------\",",
"\"     Bốn cột pha lê trên đàn tròn khắc 60 hoa giáp: chân là Địa Chi, lõi sáng là tàng can, đầu là Thiên Can.\",",
"\"     Phía trước là bánh xe ngũ hành phát sáng, phía sau là con đường đại vận. Hậu kỳ phát sáng (bloom) khi trình duyệt hỗ trợ. */\",",
"\"  var T = null, S = null;\",",
"\"  var XT = [-6.3, -2.1, 2.1, 6.3], ZT = -1.2;                   // Năm, Tháng, Ngày, Giờ – trái sang phải\",",
"\"  var TAM_HANH = { c: [0, 0.9, 7.4], r: 4.1 };\",",
"\"  function viTriHanh(h) { var i = SINH.indexOf(h), a = i / 5 * Math.PI * 2 - Math.PI / 2; return [TAM_HANH.c[0] + TAM_HANH.r * Math.cos(a), TAM_HANH.c[1], TAM_HANH.c[2] + TAM_HANH.r * Math.sin(a)]; }\",",
"\"  function taoCv(w, h) { var c = document.createElement('canvas'); c.width = w; c.height = h || w; return c; }\",",
"\"  function texCv(c) { var t = new T.CanvasTexture(c); t.colorSpace = T.SRGBColorSpace; t.anisotropy = 4; return t; }\",",
"\"  function veNen() { var c = taoCv(1024), g = c.getContext('2d'), gr = g.createRadialGradient(440, 470, 30, 480, 520, 760); gr.addColorStop(0, '#12324c'); gr.addColorStop(0.42, '#0a1c2e'); gr.addColorStop(1, '#02060b'); g.fillStyle = gr; g.fillRect(0, 0, 1024, 1024); return c; }\",",
"\"  function veCot() { var c = taoCv(8, 256), g = c.getContext('2d'), gr = g.createLinearGradient(0, 0, 0, 256); gr.addColorStop(0, 'rgba(255,255,255,0)'); gr.addColorStop(0.7, 'rgba(255,255,255,.35)'); gr.addColorStop(1, 'rgba(255,255,255,1)'); g.fillStyle = gr; g.fillRect(0, 0, 8, 256); return c; }\",",
"\"  /** Mặt đàn: vành 60 hoa giáp, vạch chia độ */\",",
"\"  function veDan() {\",",
"\"    var N = 2048, c = taoCv(N), g = c.getContext('2d'), cx = N / 2, s = N / 2 / 12.6, can = Object.keys(CAN), chi = Object.keys(CON_GIAP);\",",
"\"    var gr = g.createRadialGradient(cx, cx, 0, cx, cx, N / 2); gr.addColorStop(0, '#11283d'); gr.addColorStop(0.7, '#0a1a29'); gr.addColorStop(1, '#07121e'); g.fillStyle = gr; g.fillRect(0, 0, N, N);\",",
"\"    function vong(r, w, a) { g.beginPath(); g.arc(cx, cx, r * s, 0, Math.PI * 2); g.lineWidth = w; g.strokeStyle = 'rgba(226,192,120,' + a + ')'; g.stroke(); }\",",
"\"    vong(12.5, 3, 0.9); vong(12.35, 1.2, 0.5); vong(11.0, 1.2, 0.5); vong(10.85, 3, 0.8); vong(9.6, 1, 0.3);\",",
"\"    g.textAlign = 'center'; g.textBaseline = 'middle'; g.font = '600 ' + Math.round(0.3 * s) + 'px \\\"Be Vietnam Pro\\\", system-ui, sans-serif';\",",
"\"    for (var i = 0; i < 60; i++) {\",",
"\"      var a = i / 60 * Math.PI * 2, x = Math.sin(a), y = Math.cos(a);\",",
"\"      g.beginPath(); g.moveTo(cx + 11.0 * s * x, cx + 11.0 * s * y); g.lineTo(cx + 12.35 * s * x, cx + 12.35 * s * y); g.lineWidth = 1; g.strokeStyle = 'rgba(226,192,120,.28)'; g.stroke();\",",
"\"      var b = a + Math.PI / 60; g.save(); g.translate(cx + 11.68 * s * Math.sin(b), cx + 11.68 * s * Math.cos(b)); g.rotate(-b - Math.PI / 2);\",",
"\"      g.fillStyle = i % 10 === 0 ? 'rgba(243,217,156,.95)' : 'rgba(210,222,232,.62)'; g.fillText(can[i % 10] + ' ' + chi[i % 12], 0, 0); g.restore();\",",
"\"    }\",",
"\"    for (i = 0; i < 120; i++) { var q = i / 120 * Math.PI * 2; g.beginPath(); g.moveTo(cx + 9.6 * s * Math.sin(q), cx + 9.6 * s * Math.cos(q)); g.lineTo(cx + (i % 10 ? 9.85 : 10.3) * s * Math.sin(q), cx + (i % 10 ? 9.85 : 10.3) * s * Math.cos(q)); g.lineWidth = i % 10 ? 1 : 2.5; g.strokeStyle = 'rgba(226,192,120,' + (i % 10 ? 0.35 : 0.8) + ')'; g.stroke(); }\",",
"\"    return c;\",",
"\"  }\",",
"\"  /** Mặt bánh xe ngũ hành: ngũ giác tương sinh, sao năm cánh tương khắc */\",",
