"\"    var N = 1024, c = taoCv(N), g = c.getContext('2d'), cx = N / 2, s = N / 2 / 5.4;\",",
"\"    var gr = g.createRadialGradient(cx, cx, 0, cx, cx, N / 2); gr.addColorStop(0, 'rgba(26,60,84,.95)'); gr.addColorStop(0.8, 'rgba(10,26,41,.95)'); gr.addColorStop(1, 'rgba(10,26,41,0)'); g.fillStyle = gr; g.fillRect(0, 0, N, N);\",",
"\"    function vong(r, w, a) { g.beginPath(); g.arc(cx, cx, r * s, 0, Math.PI * 2); g.lineWidth = w; g.strokeStyle = 'rgba(226,192,120,' + a + ')'; g.stroke(); }\",",
