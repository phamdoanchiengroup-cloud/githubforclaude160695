"\"  function ve3D(M) {\",",
"\"    var cv = $('c'), san = $('san'), cong = T.AdditiveBlending;\",",
"\"    var R = new T.WebGLRenderer({ canvas: cv, antialias: true, powerPreference: 'high-performance' }); R.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\",",
"\"    R.toneMapping = T.ACESFilmicToneMapping; R.toneMappingExposure = 1.08; R.outputColorSpace = T.SRGBColorSpace;\",",
"\"    var sc = new T.Scene(); sc.background = texCv(veNen()); sc.fog = new T.FogExp2(0x050d17, 0.009);\",",
"\"    var cam = new T.PerspectiveCamera(38, 1, 0.1, 600);\",",
"\"    var pm = new T.PMREMGenerator(R); sc.environment = pm.fromScene(canhPhanChieu(), 0.03).texture; pm.dispose();\",",
"\"    sc.add(new T.HemisphereLight(0x8fb6d8, 0x08121d, 0.55));\",",
"\"    var dl = new T.DirectionalLight(0xffe0a8, 1.4); dl.position.set(8, 22, 16); sc.add(dl);\",",
"\"    var dl2 = new T.DirectionalLight(0x3fc6d0, 0.8); dl2.position.set(-14, 8, -12); sc.add(dl2);\",",
"\"    var texQ = texCv(veQuang('rgba(255,255,255,1)'));\",",
"\"    function sprite(cnv, w, x, y, z) { var sp = new T.Sprite(new T.SpriteMaterial({ map: texCv(cnv), transparent: true, depthWrite: false, toneMapped: false, color: new T.Color(0.92, 0.92, 0.92) })); sp.scale.set(w, w * cnv.height / cnv.width, 1); sp.position.set(x, y, z); sc.add(sp); return sp; }\",",
"\"    function quang(mau, co, op) { var q = new T.Sprite(new T.SpriteMaterial({ map: texQ, color: mau, transparent: true, opacity: op, blending: cong, depthWrite: false })); q.scale.set(co, co, 1); return q; }\",",
"\"    // Bầu sao + tinh vân\",",
"\"    var nS = 2600, ps = new Float32Array(nS * 3), cs = new Float32Array(nS * 3), bang = [new T.Color(0xcfe3ff), new T.Color(0xfff0d0), new T.Color(0x9fe6e6)];\",",
"\"    for (var i = 0; i < nS; i++) {\",",
"\"      var u = Math.random() * 2 - 1, th = Math.random() * Math.PI * 2, r = 90 + Math.random() * 90, sq = Math.sqrt(1 - u * u);\",",
"\"      ps[i * 3] = r * sq * Math.cos(th); ps[i * 3 + 1] = Math.abs(r * u) * 0.9 - 12; ps[i * 3 + 2] = r * sq * Math.sin(th);\",",
"\"      var mm = bang[i % 3].clone().multiplyScalar(0.35 + Math.pow(Math.random(), 3) * 1.4); cs[i * 3] = mm.r; cs[i * 3 + 1] = mm.g; cs[i * 3 + 2] = mm.b;\",",
