"\"    g.beginPath(); d.forEach(function (p, i) { var q = d[(i * 2) % 5]; g[i ? 'lineTo' : 'moveTo'](q[0], q[1]); }); g.closePath(); g.lineWidth = 2; g.strokeStyle = 'rgba(232,137,122,.35)'; g.stroke();\",",
"\"    for (var i = 0; i < 72; i++) { var q = i / 72 * Math.PI * 2; g.beginPath(); g.moveTo(cx + 5.0 * s * Math.cos(q), cx + 5.0 * s * Math.sin(q)); g.lineTo(cx + (i % 6 ? 4.85 : 4.7) * s * Math.cos(q), cx + (i % 6 ? 4.85 : 4.7) * s * Math.sin(q)); g.lineWidth = 1.2; g.strokeStyle = 'rgba(226,192,120,.45)'; g.stroke(); }\",",
"\"    return c;\",",
"\"  }\",",
