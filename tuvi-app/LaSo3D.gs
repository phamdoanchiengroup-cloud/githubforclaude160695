"\"    var sao = new T.Points(gS, new T.PointsMaterial({ size: 1.5, map: texQ, vertexColors: true, transparent: true, depthWrite: false, blending: cong, fog: false })); sc.add(sao);\",",
"\"    [[0x1b6d78, -80, 34, -130, 170], [0x3a2a6e, 100, 50, -120, 190], [0x6b4f1f, 20, -6, -160, 140], [0x14506a, -140, 10, 40, 170], [0x2a1f55, 130, 20, 60, 150]].forEach(function (n) {\",",
"\"      var sp = quang(n[0], n[4], 0.5); sp.material.fog = false; sp.position.set(n[1], n[2], n[3]); sc.add(sp);\",",
"\"    });\",",
"\"    // Đàn tròn\",",
"\"    var kimVang = new T.MeshStandardMaterial({ color: 0xd6b064, metalness: 1, roughness: 0.26 });\",",
